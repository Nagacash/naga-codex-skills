{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test)",
      "Bash(npm run check)",
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(npm run preview)",
      "Bash(npm run dev)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(gh pr *)",
      "Bash(gh repo *)",
      "Bash(npm install*)",
      "Bash(npx *)",
      "Bash(docker *)",
      "Bash(rm -rf *)",
      "Bash(sudo *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*secret*)",
      "Read(**/*credential*)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Bash(cat .env*)",
      "Bash(printenv *)"
    ]
  },
  "notes": "Allow/Ask/Deny baseline for Naga Codex workflow. Project instructions guide the model; these rules enforce hard restrictions where Claude Code supports them. Allow .env.example reads via explicit user override if needed."
}
